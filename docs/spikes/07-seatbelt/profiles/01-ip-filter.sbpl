;; Probe A: IP filtering
;; Hypothesis: (deny network-outbound) + (allow network-outbound (remote ip "1.1.1.1:80"))
;; filters outbound connections by remote IP on macOS 15.
;;
;; Expected: curl http://1.1.1.1 succeeds (HTTP 301), curl http://1.0.0.1 blocked.
(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "1.1.1.1:80"))
