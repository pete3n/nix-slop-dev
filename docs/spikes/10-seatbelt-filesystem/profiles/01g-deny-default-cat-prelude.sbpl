;; Probe 01g: deny default + broader cat prelude, allow only test1/allow.
;; Adds the deny categories the log surfaced under 01f: sysctl-read, file-read
;; for root, etc.
(version 1)
(deny default)
(allow process*)
(allow file-read*)            ;; allow reads broadly; then deny test1, allow test1/allow
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm*)
(allow signal)
(deny file-read* (subpath "/tmp/spike10/test1"))
(allow file-read* (subpath "/tmp/spike10/test1/allow"))
